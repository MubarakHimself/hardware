[Unit]
Description=Hardware PostgreSQL backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
WorkingDirectory=/opt/hardware
Environment=ENV_FILE=/opt/hardware/.env.production
ExecStart=/opt/hardware/deploy/backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target

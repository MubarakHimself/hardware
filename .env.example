# Hardware Personal Local v1.1
APP_MODE=local
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
HARDWARE_PORT=3000
LOCAL_OWNER_ID=00000000-0000-4000-8000-000000000001
LOCAL_OWNER_NAME=Local owner

# PostgreSQL stays inside Docker. Generate a unique password during setup.
POSTGRES_DB=hardware
POSTGRES_USER=hardware
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://hardware:replace_me@postgres:5432/hardware
DATABASE_POOL_MAX=8
DATABASE_SSL=false
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Provider credentials. Hardware stores metadata only; it never downloads video.
YOUTUBE_API_KEY=
GITHUB_TOKEN=
SOURCE_HTTP_TIMEOUT_MS=10000

# Local runtime
HEALTHCHECK_TOKEN=
LOG_LEVEL=info
WORKER_CONCURRENCY=2
RELEASE_SHA=

# Backups are encrypted before they enter this directory.
HARDWARE_BACKUP_DIR=./backups
BACKUP_KEY_FILE=./.hardware/backup.key
BACKUP_RETENTION_DAYS=7
BACKUP_RETENTION_WEEKS=4

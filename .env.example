# Public application configuration
APP_DOMAIN=hardware.example.com
ACME_EMAIL=admin@example.com
NEXT_PUBLIC_APP_URL=https://hardware.example.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Clerk server credentials. Never expose these as NEXT_PUBLIC_* values.
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me
ADMIN_CLERK_USER_IDS=user_replace_me

# Application probe secret. Generate one before deployment, for example:
# openssl rand -base64 48
HEALTHCHECK_TOKEN=

# PostgreSQL. DATABASE_URL uses the Docker service name in production.
POSTGRES_DB=hardware
POSTGRES_USER=hardware
POSTGRES_PASSWORD=replace_with_a_long_random_value
DATABASE_URL=postgresql://hardware:replace_with_a_long_random_value@postgres:5432/hardware
DATABASE_POOL_MAX=10
DATABASE_SSL=false
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Deterministic source integrations
YOUTUBE_API_KEY=replace_me
GITHUB_TOKEN=

# Runtime
NODE_ENV=production
DEMO_MODE=false
LOG_LEVEL=info
WORKER_CONCURRENCY=4
RELEASE_SHA=

# Host-run backup configuration
BACKUP_DIR=/var/backups/hardware
BACKUP_RETENTION_DAYS=7
BACKUP_RETENTION_WEEKS=4
# Root-owned, mode 0400/0600 file containing one random line of 32+ characters.
BACKUP_ENCRYPTION_KEY_FILE=/root/.config/hardware/backup-encryption.key
# Required before production launch for an additional encrypted off-host copy.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=

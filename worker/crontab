# Hardware schedules are expressed in UTC and use stable identifiers.
# Hourly due-source sweep. Each channel's stored policy is Manual, Daily, or Weekly.
0 * * * * schedule_channel_polls ?id=channelPollsV2&fill=2h&max=3

# Daily batches enforce YouTube's rolling revalidation requirement.
15 2 * * * schedule_youtube_revalidation ?id=youtubeRevalidationV1&fill=25h&max=3

# Repositories are refreshed no more than once per seven days by the scheduler query.
45 2 * * * schedule_repository_refreshes ?id=repositoryRefreshV1&fill=25h&max=3

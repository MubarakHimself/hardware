{
  "name": "hardware",
  "version": "0.1.0",
  "private": true,
  "description": "A personal, local desktop library for noteworthy open-source projects.",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build && npm run runtime:build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern dist-worker --ignore-pattern coverage --ignore-pattern playwright-report --ignore-pattern test-results",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:watch": "vitest tests/unit",
    "test:bdd": "node --import tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.mjs",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm run typecheck && npm run test && npm run test:bdd && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx db/migrate.ts",
    "db:migrate:compiled": "node dist-db/migrate.js",
    "db:smoke": "tsx tests/integration/database-smoke.ts",
    "db:api-smoke": "node --conditions=react-server --import tsx tests/integration/api-database-smoke.ts",
    "db:mutation-smoke": "node --conditions=react-server --import tsx tests/integration/mutation-database-smoke.ts",
    "db:studio": "drizzle-kit studio",
    "worker:dev": "tsx --env-file=.env.local worker/index.ts",
    "runtime:build": "npm run worker:build && npm run db:build",
    "worker:build": "tsup ./worker/index.ts --format esm --platform node --target node24 --out-dir dist-worker --sourcemap --clean && node ./worker/copy-assets.mjs",
    "worker:start": "node dist-worker/index.js",
    "db:build": "tsup ./db/migrate.ts --format esm --platform node --target node24 --out-dir dist-db --sourcemap --clean",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "verify:runtime": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\deploy\\verify-local-runtime.ps1"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "graphile-worker": "^0.16.6",
    "lucide-react": "^0.545.0",
    "next": "^16.2.11",
    "pg": "^8.16.3",
    "pino": "^9.9.5",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cucumber/cucumber": "^12.2.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "^27.0.0",
    "pino-pretty": "^13.1.1",
    "tailwindcss": "4.2.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "postcss": "8.5.22",
    "sharp": "0.35.3"
  },
  "type": "module"
}
